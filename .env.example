# Optional: set to use OpenAI embeddings + LLM rerank/comment drafting.
# Leave empty to use the local hashing embedder + heuristic reranker.
OPENAI_API_KEY=

# Database (SQLite by default for local demos)
DATABASE_URL=sqlite:///./agent_network.db

# Webhook HMAC secret shared with agents
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Routing knobs
ROUTING_TOP_K=50
ROUTING_FINAL_LIMIT=5
ROUTING_RERANK_THRESHOLD=0.55
EMBEDDING_DIM=384